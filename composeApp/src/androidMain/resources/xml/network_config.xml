<network-security-config>
    <!-- Свежие корни ISRG (Let's Encrypt) дополнительно к системным: у кастомных
         ROM (планшет Android 7.1) устаревшее хранилище CA — без них xmlcalendar.ru
         падает SSLHandshakeException: Trust anchor not found -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">dataservice.accuweather.com</domain>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">openweathermap.org</domain>
    </domain-config>
</network-security-config>
