import kotlin.Int;

CREATE TABLE IF NOT EXISTS Temperature (
    pid	            INTEGER PRIMARY KEY AUTOINCREMENT,
	min_value	    REAL            NOT NULL,
	max_value	    REAL            NOT NULL,
	min_unit	    TEXT            NOT NULL,
	max_unit	    TEXT            NOT NULL,
	min_unit_type	INTEGER AS Int  NOT NULL DEFAULT -1,
	max_unit_type	INTEGER AS Int  NOT NULL DEFAULT -1,
	min_phrase	    TEXT,
	max_phrase	    TEXT,
	forecast_pid	INTEGER         NOT NULL,
	FOREIGN KEY(forecast_pid) REFERENCES DailyForecast(pid) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS temperature_forecast_pid ON Temperature (forecast_pid ASC);

insert:
REPLACE INTO Temperature
    VALUES (?,?,?,?,?,?,?,?,?,?);

lastPid:
SELECT MAX(pid) FROM Temperature;

getByForecastPid:
SELECT * FROM Temperature WHERE forecast_pid =?;

-- Батч-чтение периода (анти-N+1): температуры всех дней диапазона
getByDateRange:
SELECT Temperature.* FROM Temperature
	JOIN DailyForecast ON DailyForecast.pid = Temperature.forecast_pid
	WHERE DailyForecast.forecast_key = ? AND DailyForecast.date >= ? AND DailyForecast.date <= ?;

