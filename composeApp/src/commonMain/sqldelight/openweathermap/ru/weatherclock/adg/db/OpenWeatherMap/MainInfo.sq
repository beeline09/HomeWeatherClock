import kotlin.Int;

CREATE TABLE IF NOT EXISTS MainInfo (
	forecast_pid	INTEGER NOT NULL,
	temperature	REAL NOT NULL,
	feels_like	REAL,
	min_temperature	REAL,
	max_temperature	REAL,
	pressure	INTEGER AS Int,
	seaLevel	INTEGER AS Int,
	ground_level	INTEGER AS Int,
	humidity	INTEGER AS Int,
	FOREIGN KEY(forecast_pid) REFERENCES ForecastItem(pid) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS main_info_forecast_pid ON MainInfo (forecast_pid ASC);

insert:
REPLACE INTO MainInfo VALUES ?;

getByForecastPid:
SELECT * FROM MainInfo WHERE forecast_pid = ?;

-- Батч-чтение периода (анти-N+1): все MainInfo диапазона одним запросом
getByDateRange:
SELECT MainInfo.* FROM MainInfo
	JOIN ForecastItem ON ForecastItem.pid = MainInfo.forecast_pid
	WHERE ForecastItem.date_time >= ? AND ForecastItem.date_time <= ?
		AND ForecastItem.latitude = ? AND ForecastItem.longitude = ?;